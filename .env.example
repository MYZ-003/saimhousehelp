# Local Windows/Android demo. No Clerk credentials or API server are needed.
API_PORT=5000
API_HOST=0.0.0.0
EXPO_PORT=8081
# true = local demo auth + mock marketplace; false = use Clerk and the API.
EXPO_PUBLIC_DEMO_MODE=true

# Only required when EXPO_PUBLIC_DEMO_MODE=false. Use the PC's current Wi-Fi
# IPv4 address for the API URL (for example, http://192.168.1.3:5000).
# EXPO_PUBLIC_API_URL=
# Clerk test instance. Keep the secret key server-side; never expose it with
# an EXPO_PUBLIC_ prefix.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_CLERK_PROXY_URL=

# Only required by the API server when demo mode is disabled. This must be a
# PostgreSQL connection string, not SUPABASE_URL or its REST API keys.
SUPABASE_DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.uyoggpwdjtfpobvwrjmn.supabase.co:5432/postgres"
